# CivicFix Environment Configuration
# Copy this file to .env and fill in values as needed.

# Data mode: "demo" (default, localStorage only) or "supabase" (requires Supabase keys below)
VITE_DATA_MODE=demo

# Contact email shown in the footer. Leave blank to show honest fallback text.
VITE_CONTACT_EMAIL=

# Supabase integration (only used when VITE_DATA_MODE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
